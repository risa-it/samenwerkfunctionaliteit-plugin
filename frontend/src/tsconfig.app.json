{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "outDir": "../out-tsc/app",
        "types": []
    },
    "angularCompilerOptions": {
        "enableIvy": true,
        "strictTemplates": true,
        "extendedDiagnostics": {
            "checks": {
                "unusedStandaloneImports": "warning",
                "uninvokedFunctionInEventBinding": "warning",
                "uninvokedTrackFunction": "warning",
                "nullishCoalescingNotNullable": "warning",
                "optionalChainNotNullable": "warning",
                "missingControlFlowDirective": "warning"
            }
        }
    },
    "files": [
        "main.ts",
        "polyfills.ts"
    ],
    "include": [
        "src/**/*.d.ts"
    ],
}